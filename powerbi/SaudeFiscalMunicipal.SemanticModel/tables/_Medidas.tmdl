	/// Rótulo formatado com seta da variação da Suficiência de Caixa Livre vs. ano anterior.
	measure 'Suficiencia de Caixa Livre YoY Label' =
			VAR vAnoAtual = MAX(dCalendario[ano])
			VAR vAnoAnterior = vAnoAtual - 1
			VAR vAtual = [Suficiencia de Caixa Livre]
			VAR vLY = CALCULATE([Suficiencia de Caixa Livre], REMOVEFILTERS(dCalendario), dCalendario[ano] = vAnoAnterior)
			VAR vDif = vAtual - vLY
			VAR vPct = DIVIDE(vDif, ABS(vLY))
			RETURN
			IF(
			    ISBLANK(vAtual) || ISBLANK(vLY),
			    "-",
			    IF(
			        vDif > 0,
			        "▲ +" & FORMAT(vPct, "0.0%") & " vs. " & vAnoAnterior,
			        IF(
			            vDif < 0,
			            "▼ " & FORMAT(vPct, "0.0%") & " vs. " & vAnoAnterior,
			            "► 0.0% vs. " & vAnoAnterior
			        )
			    )
			)
		displayFolder: 05. Variações YoY & Cartões
		lineageTag: b9938eaf-1bc5-4e8a-982f-9ddf3d25ab98

	/// Cor hexadecimal da Suficiência de Caixa Livre (Verde se positivo >= 0, Vermelho se negativo < 0).
