	/// Sparkline SVG com gradiente da População do Exercício (últimos 5 anos).
	measure 'Populacao do Exercicio Sparkline SVG' = ```
			VAR svg_width = 150  -- Control width
			VAR svg_height = 50  -- Control height
			VAR stroke_color = "#9126B6" --Control Sparkline Stroke Color
			VAR gradient_color = "#E6BCF4" --Control Sparkline Gradient Color
			VAR grad_id = "grad_pop"
			
			VAR vAnoMax = MAX(dCalendario[ano])
			VAR vAnoMin = vAnoMax - 4
			
			VAR InputTable =  -- Input Columns
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            SUMMARIZECOLUMNS(
			                dCalendario[ano],
			                "Y", [Populacao do Exercicio]
			            ),
			            "X", dCalendario[ano],
			            "Y", [Y]
			        ),
			        REMOVEFILTERS(dCalendario),
			        dCalendario[ano] >= vAnoMin && dCalendario[ano] <= vAnoMax
			    )
			
			VAR NonBlankData =
			    ADDCOLUMNS(
			        InputTable,
			        "Y_Adj", IF(ISBLANK([Y]), 0, [Y])
			    )
			
			VAR RankedData =
			    ADDCOLUMNS(
			        NonBlankData,
			        "X_Rank", RANKX(NonBlankData, [X], , ASC)
			    )
			
			VAR TotalPoints = COUNTROWS(RankedData)
			VAR MaxIndex = TotalPoints - 1
			VAR SpacedPoints =
			    ADDCOLUMNS(
			        RankedData,
			        "XPos", 
			            IF(MaxIndex <= 0, svg_width * 0.5, DIVIDE(([X_Rank] - 1), MaxIndex) * svg_width)
			    )
			
			VAR MinY = MINX(SpacedPoints, [Y_Adj])
			VAR MaxY = MAXX(SpacedPoints, [Y_Adj])
			
			VAR PointsWithYPos =
			    ADDCOLUMNS(
			        SpacedPoints,
			        "YPos",
			        IF(
			            MaxY = MinY,
			            svg_height * 0.5,
			            svg_height - 6 - DIVIDE([Y_Adj] - MinY, MaxY - MinY) * (svg_height - 12)
			        )
			    )
			
			VAR PolylinePoints =
			    CONCATENATEX(
			        PointsWithYPos,
			        SUBSTITUTE(FORMAT([XPos], "0.0"), ",", ".") & "," & SUBSTITUTE(FORMAT([YPos], "0.0"), ",", "."),
			        " ",
			        [X],
			        ASC
			    )
			
			VAR FirstX = SUBSTITUTE(FORMAT(MINX(PointsWithYPos, [XPos]), "0.0"), ",", ".")
			VAR LastX = SUBSTITUTE(FORMAT(MAXX(PointsWithYPos, [XPos]), "0.0"), ",", ".")
			VAR PolygonPoints =
			    FirstX & "," & svg_height & " " & PolylinePoints & " " & LastX & "," & svg_height
			
			VAR Svg =
			    "<svg width='" & svg_width & "' height='" & svg_height & "' viewBox='0 0 " & svg_width & " " & svg_height & "' xmlns='http://www.w3.org/2000/svg'>" &
			    "<defs>" &
			        "<linearGradient id='" & grad_id & "' x1='0' y1='0' x2='0' y2='1'>" &
			            "<stop offset='0%' stop-color='"& gradient_color &"' stop-opacity='0.6'/>" &
			            "<stop offset='100%' stop-color='"& gradient_color &"' stop-opacity='0'/>" &
			        "</linearGradient>" &
			    "</defs>" &
			    "<polygon fill='url(#" & grad_id & ")' points='" & PolygonPoints & "' />" &
			    "<polyline fill='none' stroke='" & stroke_color & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' points='" & PolylinePoints & "' />" &
			    "</svg>"
			
			RETURN
			    IF(TotalPoints < 2, BLANK(), "data:image/svg+xml;utf8," & Svg)
			```
		displayFolder: 05. Variações YoY & Cartões
		lineageTag: 9a4c6eda-d29f-4c9e-8adb-60e29284c9ee
		dataCategory: ImageUrl

	measure 'Subtitulo Indicadores' = ```
			
			VAR vUltData = MAX(fIndicador[sk_data_fim_periodo])
			VAR vQuantidade = 
			    IF(
			        ISBLANK(vUltData),
			        BLANK(),
			        CALCULATE(
			            COUNTROWS(fIndicador),
			            dCalendario[sk_data] = vUltData,
			            fIndicador[status_limite] IN {"ALERTA", "PRUDENCIAL", "ACIMA_LIMITE"}
			        ) + 0
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        -- 1ª Condição: Se a data for em branco
			        ISBLANK(vUltData), "Sem dados no período selecionado",
			        
			        -- 2ª Condição: Se a quantidade for zero ou vazia
			        ISBLANK(vQuantidade) || vQuantidade = 0, "Nenhum alerta fiscal",
			        
			        vQuantidade < 2, FORMAT(vQuantidade, "#,##0") & " Alerta Fiscal",
			
			        FORMAT(vQuantidade, "#,##0") & " Alertas Fiscais"
			
			    )
			
			```
		displayFolder: 05. Variações YoY & Cartões
		lineageTag: 4a85d397-04e1-4be8-8cde-a84d4897d79c

