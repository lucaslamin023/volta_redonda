	/// Variação nominal absoluta da Suficiência de Caixa Livre vs. ano anterior (respeita cgEscalaValor).
	measure 'Suficiencia de Caixa Livre YoY Var' =
			VAR vAnoAtual = MAX(dCalendario[ano])
			VAR vAtual = [Suficiencia de Caixa Livre]
			VAR vLY = CALCULATE([Suficiencia de Caixa Livre], REMOVEFILTERS(dCalendario), dCalendario[ano] = vAnoAtual - 1)
			RETURN
			IF(ISBLANK(vAtual) || ISBLANK(vLY), BLANK(), vAtual - vLY)
		displayFolder: 05. Variações YoY & Cartões
