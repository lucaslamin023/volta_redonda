# PostgreSQL (Docker isolado na porta 5433 para nao conflitar com Postgres nativo na 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=siconfi_dw
POSTGRES_USER=etl_admin
POSTGRES_PASSWORD=troque_esta_senha_etl

# Usuario somente-leitura exclusivo para o Power BI (acesso apenas aos schemas gold e bi)
POWERBI_RO_USER=powerbi_ro
POWERBI_RO_PASSWORD=troque_esta_senha_bi

# API SICONFI / STN
SICONFI_BASE_URL=https://apidatalake.tesouro.gov.br/ords/siconfi/tt
SICONFI_FALLBACK_URL=https://apidatalake.tesouro.gov.br/ords/cdwhprd/siconfi/tt
SICONFI_RATE_LIMIT_SECONDS=1.10
SICONFI_TIMEOUT_SECONDS=60.0

# Escopo Municipal: Volta Redonda (3306305) + Cidades-Pares RJ/Sul Fluminense para Benchmarking
# 3306305 = Volta Redonda | 3300407 = Barra Mansa | 3304201 = Resende
# 3300100 = Angra dos Reis | 3303906 = Petropolis | 3302403 = Macae
ENTE_PRINCIPAL=3306305
ENTES_ESCOPO=3306305,3300407,3304201,3300100,3303906,3302403

# Janela Temporal de Extracao Bruta (Bronze)
ANO_INICIAL_EXTRACAO=2015
ANO_FINAL_EXTRACAO=2026
